{
    "name": "horde/dav",
    "description": "WebDAV, CalDAV, and CardDAV library",
    "type": "horde-library",
    "homepage": "https://www.horde.org",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "webdav",
        "caldav",
        "carddav"
    ],
    "time": "2026-04-25",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "^3 || ^2",
        "php": "^8.1",
        "horde/auth": "^3",
        "horde/core": "^3",
        "horde/http": "^3",
        "horde/stream": "^2",
        "horde/translation": "^3",
        "sabre/dav": "^4.7",
        "ext-ctype": "*",
        "ext-date": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "ext-simplexml": "*",
        "ext-spl": "*"
    },
    "require-dev": {},
    "suggest": {
        "ext-curl": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Dav": "lib/"
        },
        "psr-4": {
            "Horde\\Dav\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Dav\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
}